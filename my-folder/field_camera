import cv2
import numpy as np
import math
import json
import os

# =========================
# CONFIG
# =========================
ARUCO_DICT = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_4X4_50)
ARUCO_PARAMS = cv2.aruco.DetectorParameters()
detector = cv2.aruco.ArucoDetector(ARUCO_DICT, ARUCO_PARAMS)

ROBOT_MARKER_ID = 0  # ID ของ marker ที่ติดบนหุ่น

CALIBRATION_FILE = "hole_calibration.json"
HOLE_LABELS = ["CYAN", "RED", "VIOLET", "BLUE", "ORANGE", "GREEN"] //crimson->red

# ค่า Hue อ้างอิง (0-179 ตามสเกล OpenCV) - เป็นค่าประมาณ ปรับได้ถ้าทายผิดบ่อย
# ตรวจสอบง่ายๆ: ตอน calibrate จริง ดูค่า hue ที่ปริ๊นออกทาง console แล้วมาปรับเลขตรงนี้ให้แม่นขึ้น
REFERENCE_COLORS = {
    "CYAN": 95,
    "BLUE": 115,
    "VIOLET": 140,
    "RED": 175,   # สีแดง/ชมพูเข้ม อยู่ใกล้ปลาย hue (วนกลับไปใกล้ 0)
    "ORANGE": 12,
    "GREEN": 55,
}


# =========================
# ROBOT POSE (ArUco)
# =========================
def find_robot_pose(frame):
    """
    คืนค่า (robot_x, robot_y, heading_deg, corners_pts) หรือ None ถ้าไม่เจอ marker
    """
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) //แปลงจากสีเป็นขาวดำ๖ทำให้เร็วขึ้นและไม่กวนกับสีพื้นหลัง
    corners, ids, _ = detector.detectMarkers(gray) //ลิส4มุมของ list aruco และ list ID

    if ids is None:
        return None

    for i, marker_id in enumerate(ids.flatten()): //วนลูปตรวจสอบ marker แต่ละตัว
        if marker_id != ROBOT_MARKER_ID:
            continue

        pts = corners[i][0]  # 4 มุม: top_left, top_right, bottom_right, bottom_left
        top_left, top_right = pts[0], pts[1]

        center = pts.mean(axis=0) //คำนวณจุดกึ่งกลางของ marker
        robot_x, robot_y = center[0], center[1]

        dx = top_right[0] - top_left[0] //หาความต่างของแกน x & y มุมบนซ้ายและบนขวาเพื่อคำนวนหามุม
        dy = top_right[1] - top_left[1]
        angle = math.degrees(math.atan2(-dy, dx)) //คำนวณมุมของหุ่นในองศา (0-360) โดยใช้ฟังก์ชัน atan2 และแปลงเป็นองศา
        if angle < 0:
            angle += 360

        return robot_x, robot_y, angle, pts

    return None


# =========================
# COLOR SAMPLING / CLASSIFICATION
# =========================
def sample_color(frame, x, y, patch=10): //วัดสีรอบจุดที่คลิก (x,y) ในรัศมี patch พิกเซล
    """
    เก็บค่าสีเฉลี่ยรอบจุด (x,y) ในรัศมี +-patch พิกเซล
    คืนค่า (mean_bgr, mean_hsv)
    """
    h, w = frame.shape[:2]
    x1, x2 = max(0, x - patch), min(w, x + patch)
    y1, y2 = max(0, y - patch), min(h, y + patch)
    region = frame[y1:y2, x1:x2]

    mean_bgr = region.reshape(-1, 3).mean(axis=0)
    mean_bgr_uint8 = np.uint8([[mean_bgr]])
    mean_hsv = cv2.cvtColor(mean_bgr_uint8, cv2.COLOR_BGR2HSV)[0][0]

    return mean_bgr, mean_hsv


def classify_hue(hue): //เทียบ hue กับ REFERENCE_COLORS เพื่อทายชื่อสี
    """
    เทียบ hue ที่วัดได้กับตาราง REFERENCE_COLORS แล้วคืนชื่อสีที่ใกล้ที่สุด
    ใช้ circular distance เพราะ hue วนกลับ (0 กับ 179 อยู่ใกล้กันจริงๆ)
    """
    best_label = None
    best_dist = 999
    for label, ref_hue in REFERENCE_COLORS.items(): //วนลูปตรวจสอบแต่ละสีอ้างอิง
        d = min(abs(hue - ref_hue), 180 - abs(hue - ref_hue)) //คำนวณระยะทางแบบวงกลมระหว่าง hueที่วัดได้ กับhueอ้างอิง
        if d < best_dist:
            best_dist = d
            best_label = label
    return best_label //สีที่ทายตรงมากสุด


# =========================
# HOLE CALIBRATION (click + auto color measure)
# =========================
def calibrate_holes(cap): 
    """
    คลิกกึ่งกลางหลุมทีละหลุม (ลำดับไหนก็ได้) - โปรแกรมวัดสีแล้วทายชื่อให้อัตโนมัติ
    y = ยืนยันตามที่ทาย, 1-6 = แก้เป็นสีที่ถูกต้องเอง, r = ยกเลิกจุดนี้
    บันทึกผลลง CALIBRATION_FILE แล้วคืนค่า dict {label: (x, y)}
    """
    hole_positions = {}
    pending = {"point": None, "guess": None, "bgr": None, "hue": None}

    def on_mouse(event, x, y, flags, param): //คลิกเมาส์ซ้ายเพื่อบันทึกตำแหน่งหลุม
        if event == cv2.EVENT_LBUTTONDOWN and pending["point"] is None:
            pending["point"] = (x, y)

    window_name = "Calibrate Holes (auto color) - q to abort"
    cv2.namedWindow(window_name)
    cv2.setMouseCallback(window_name, on_mouse) //สร้างหน้าต่าง แล้วผูกกับการคลิกกเม้าส์

    print("=== CALIBRATE HOLES (วัดสีอัตโนมัติ) ===")
    print("คลิกที่กึ่งกลางหลุมทีละหลุม (คลิกลำดับไหนก็ได้)")
    print("y = ยืนยันตามที่ทาย | 1-6 = แก้เป็นสีที่ถูกต้องเอง | r = ยกเลิกจุดนี้")

    while len(hole_positions) < len(HOLE_LABELS): //วนลูปจนกว่าจะเลือกเสร็จทุกสี
        ret, frame = cap.read()
        if not ret:
            continue

        display = frame.copy()

        # วาดหลุมที่ยืนยันแล้ว
        for label, (hx, hy) in hole_positions.items():
            cv2.circle(display, (hx, hy), 8, (0, 255, 0), -1)
            cv2.putText(display, label, (hx + 10, hy),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

        # เพิ่งคลิก ยังไม่เคย sample สี -> sample ครั้งเดียว
        if pending["point"] is not None and pending["guess"] is None: 
            px, py = pending["point"]
            mean_bgr, mean_hsv = sample_color(frame, px, py)
            pending["bgr"] = mean_bgr
            pending["hue"] = int(mean_hsv[0])
            pending["guess"] = classify_hue(mean_hsv[0])
            print(f"วัดสีที่ ({px},{py}) -> hue={pending['hue']} -> ทายว่า {pending['guess']}")

        if pending["point"] is not None:
            px, py = pending["point"]
            guess = pending["guess"]
            bgr = pending["bgr"]

            cv2.circle(display, (px, py), 8, (0, 0, 255), 2)
            swatch_color = tuple(int(c) for c in bgr)
            cv2.rectangle(display, (px + 15, py - 15), (px + 55, py + 15), swatch_color, -1)
            cv2.rectangle(display, (px + 15, py - 15), (px + 55, py + 15), (255, 255, 255), 1)

            warn = "  (ใช้ไปแล้ว - จะเขียนทับ)" if guess in hole_positions else ""
            cv2.putText(display, f"Detected: {guess}  (hue={pending['hue']}){warn}", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
            cv2.putText(display, "y=confirm  1-6=override  r=cancel", (20, 70),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
            for idx, lbl in enumerate(HOLE_LABELS):
                cv2.putText(display, f"{idx + 1}={lbl}", (20, 100 + idx * 22),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 200), 1)
        else:
            remaining = [l for l in HOLE_LABELS if l not in hole_positions]
            cv2.putText(display, f"เหลืออีก {len(remaining)} หลุม: {', '.join(remaining)}", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)

        cv2.imshow(window_name, display)
        key = cv2.waitKey(1) & 0xFF

        if key == ord("q"):
            break

        if pending["point"] is not None:
            px, py = pending["point"]
            chosen_label = None

            if key == ord("y"):
                chosen_label = pending["guess"]
            elif key in [ord(str(n)) for n in range(1, 7)]:
                chosen_label = HOLE_LABELS[int(chr(key)) - 1]
            elif key == ord("r"):
                pending["point"] = None
                pending["guess"] = None
                pending["bgr"] = None
                pending["hue"] = None

            if chosen_label is not None:
                hole_positions[chosen_label] = (px, py)
                print(f"บันทึก {chosen_label} ที่ตำแหน่ง ({px},{py})")
                pending["point"] = None
                pending["guess"] = None
                pending["bgr"] = None
                pending["hue"] = None

    cv2.destroyWindow(window_name)

    with open(CALIBRATION_FILE, "w") as f:
        json.dump(hole_positions, f, indent=2)

    print("บันทึก calibration เรียบร้อย:", hole_positions)
    return hole_positions


def load_hole_calibration():
    """คืนค่า dict {label: (x, y)} จากไฟล์ที่เคย calibrate ไว้ หรือ None ถ้ายังไม่มี"""
    if not os.path.exists(CALIBRATION_FILE):
        return None
    with open(CALIBRATION_FILE, "r") as f:
        data = json.load(f)
    return {k: tuple(v) for k, v in data.items()}


# =========================
# STANDALONE PREVIEW / CALIBRATION TOOL
# (รันไฟล์นี้ตรงๆ เพื่อทดสอบ ArUco detection + ดูหลุมที่ calibrate ไว้)
# กด 'c' เพื่อ calibrate หลุมใหม่, 'q' เพื่อออก
# =========================
if __name__ == "__main__":
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("เปิดกล้องไม่ได้")
        exit()

    holes = load_hole_calibration()
    if holes is None:
        holes = calibrate_holes(cap)

    while True:
        ret, frame = cap.read()
        if not ret:
            print("อ่านภาพจากกล้องไม่ได้")
            break

        pose = find_robot_pose(frame)

        if pose is not None:
            robot_x, robot_y, angle, pts = pose
            pts_int = pts.astype(int)
            cv2.polylines(frame, [pts_int], True, (0, 255, 0), 2)
            cv2.circle(frame, (int(robot_x), int(robot_y)), 8, (0, 255, 255), -1)

            arrow_len = 60
            end_x = int(robot_x + arrow_len * math.cos(math.radians(angle)))
            end_y = int(robot_y - arrow_len * math.sin(math.radians(angle)))
            cv2.arrowedLine(frame, (int(robot_x), int(robot_y)), (end_x, end_y),
                             (0, 0, 255), 3, tipLength=0.3)

            cv2.putText(frame, f"X:{robot_x:.0f} Y:{robot_y:.0f} H:{angle:.1f}", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        else:
            cv2.putText(frame, "Robot marker not detected", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2)

        for label, (hx, hy) in holes.items():
            cv2.circle(frame, (hx, hy), 10, (255, 0, 255), 2)
            cv2.putText(frame, label, (hx + 12, hy), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 255), 1)

        cv2.putText(frame, "Press 'c' to recalibrate holes, 'q' to quit",
                    (20, frame.shape[0] - 20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

        cv2.imshow("Field Camera", frame)
        key = cv2.waitKey(1) & 0xFF
        if key == ord("q"):
            break
        elif key == ord("c"):
            holes = calibrate_holes(cap)

    cap.release()
    cv2.destroyAllWindows()
