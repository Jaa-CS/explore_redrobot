import cv2
import math
import time
import requests

from field_camera import find_robot_pose, load_hole_calibration, calibrate_holes

# =========================
# CONFIG
# =========================
ESP32_IP = "192.168.1.50"  # TODO: แก้เป็น IP จริงของ ESP32

ANGLE_TOLERANCE = 15      # องศา - ถ้ามุมต่างน้อยกว่านี้ถือว่าตรงพอแล้ว วิ่งตรงได้
DISTANCE_TOLERANCE = 25   # pixel - ถ้าใกล้เป้าหมายน้อยกว่านี้ถือว่าถึงแล้ว
SEND_INTERVAL = 0.3       # วินาที - กันส่งคำสั่งไป ESP32 ถี่เกินไป

# ปุ่มตัวเลข 1-6 ใช้จำลองสีอัญมณีตอนยังไม่ได้ต่อ HuskyLens จริง
COLOR_KEYS = {
    ord("1"): "CYAN",
    ord("2"): "RED",
    ord("3"): "VIOLET",
    ord("4"): "BLUE",
    ord("5"): "ORANGE",
    ord("6"): "GREEN",
}


# =========================
# ESP32 COMMUNICATION
# =========================
def send_command(cmd):
    try:
        requests.get(f"http://{ESP32_IP}/move", params={"cmd": cmd}, timeout=1)
    except requests.exceptions.RequestException as e:
        print("ส่งคำสั่งไม่สำเร็จ:", e)


# =========================
# GEMSTONE COLOR (placeholder)
# =========================
def get_gemstone_color(sim_color):
    """
    TODO: เชื่อมกับ HuskyLens จริง แทนที่ฟังก์ชันนี้
    ตอนนี้ใช้ sim_color ที่กดจากคีย์บอร์ด (1-6) แทน เพื่อทดสอบ logic การนำทางก่อน
    ต้องรู้ก่อนว่า HuskyLens เชื่อมกับ PC ยังไง (USB-Serial ตรง / ผ่าน ESP32 แล้วส่งต่อ Wi-Fi)
    ถึงจะเขียนส่วนนี้ให้เสร็จสมบูรณ์ได้
    """
    return sim_color


# =========================
# NAVIGATION LOGIC
# =========================
def decide_command(robot_x, robot_y, heading, target_x, target_y):
    dx = target_x - robot_x
    dy = target_y - robot_y
    distance = math.hypot(dx, dy)

    if distance < DISTANCE_TOLERANCE:
        return "S"  # ถึงเป้าหมายแล้ว หยุด

    target_angle = math.degrees(math.atan2(-dy, dx))
    if target_angle < 0:
        target_angle += 360

    diff = (target_angle - heading + 180) % 360 - 180  # normalize เป็น -180..180

    if abs(diff) <= ANGLE_TOLERANCE:
        return "F"
    elif diff > 0:
        return "L"   # TODO: ถ้าทดสอบแล้วหุ่นหมุนผิดทาง ให้สลับเป็น "R"
    else:
        return "R"


# =========================
# MAIN
# =========================
def main():
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("เปิดกล้องไม่ได้")
        return

    holes = load_hole_calibration()
    if holes is None:
        print("ยังไม่ได้ calibrate หลุม กำลังเข้าสู่โหมด calibrate...")
        holes = calibrate_holes(cap)

    sim_color = None
    last_cmd = None
    last_send_time = 0

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        key = cv2.waitKey(1) & 0xFF
        if key in COLOR_KEYS:
            sim_color = COLOR_KEYS[key]
            print("จำลองสีอัญมณี:", sim_color)
        if key == ord("q"):
            break

        pose = find_robot_pose(frame)
        gemstone_color = get_gemstone_color(sim_color)

        if pose is not None and gemstone_color is not None and gemstone_color in holes:
            robot_x, robot_y, heading, pts = pose
            target_x, target_y = holes[gemstone_color]

            cmd = decide_command(robot_x, robot_y, heading, target_x, target_y)

            now = time.time()
            if cmd != last_cmd or (now - last_send_time) > SEND_INTERVAL:
                send_command(cmd)
                last_cmd = cmd
                last_send_time = now

            pts_int = pts.astype(int)
            cv2.polylines(frame, [pts_int], True, (0, 255, 0), 2)
            cv2.circle(frame, (int(robot_x), int(robot_y)), 6, (0, 255, 255), -1)
            cv2.circle(frame, (int(target_x), int(target_y)), 10, (255, 0, 255), 2)
            cv2.line(frame, (int(robot_x), int(robot_y)), (int(target_x), int(target_y)), (255, 0, 255), 2)
            cv2.putText(frame, f"Target: {gemstone_color}  Cmd: {cmd}", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        else:
            cv2.putText(frame, "Waiting for robot / gemstone color...", (20, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

        for label, (hx, hy) in holes.items():
            cv2.circle(frame, (hx, hy), 8, (200, 200, 0), 2)
            cv2.putText(frame, label, (hx + 10, hy), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 0), 1)

        cv2.putText(frame, "Press 1-6 = simulate gemstone color, q = quit",
                    (20, frame.shape[0] - 20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

        cv2.imshow("Target Navigation (test mode)", frame)

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
